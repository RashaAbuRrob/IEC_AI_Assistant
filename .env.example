# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real secrets.

# API key for Gemini Flash (primary generation model). Get one at
# https://aistudio.google.com/apikey. Without this set, the app falls back
# to the local Ollama qwen3:14b model automatically.
GEMINI_API_KEY=

# Optional: override the Gemini model id (default: gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Same GEMINI_API_KEY also enables Gemini's native text-to-speech (natural,
# ChatGPT-voice-mode-style prosody, Jordanian-accented) as the primary
# voice, replacing edge-tts. NOTE: the free tier is capped at 10 TTS
# requests/day -- expect it to fall back to edge-tts often unless billing
# is enabled on the key.
# Optional overrides (default voice "Achird" is male):
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Achird
